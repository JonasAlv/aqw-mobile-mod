// Script: Shadow Battleon - Temp Item Tracking Diagnostic
//
// Purpose: prove that quest handling and inventory/temp-inventory polling can run at the same time
// WITHOUT double-counting quest items.
//
// Shadow Battleon quests 9421/9422/9423 award "Shadow Hunt Medal" and "Mega Shadow Hunt Medal" as
// *temporary* quest items - they live in avatar.tempitems, not the backpack, so they are exactly the
// items that a container mix-up would corrupt.
//
// How to read the output
// ----------------------
// For each medal we log FOUR independent readings:
//   temp   = getTempQuantity(name)   - the temp container only
//   quest  = getQuestQuantity(name)  - backpack + temp + invTree, de-duplicated
//   inv    = getQuantity(name)       - the backpack only
//   where  = getItemLocation(name)   - which container the API resolved
//
// The invariant to watch: `quest` must equal EITHER `temp` OR `inv`, never their sum. getQuestQuantity
// de-duplicates by ItemID across every container it inspects, so a medal visible in both the backpack
// and the temp container is still counted once. If `quest` ever drifts above both, something is
// counting the same stack twice.
//
// A second invariant: `total` must be stable while nothing is being picked up. A rising total with no
// kills is the signature of double counting.
//
// Rules this script deliberately follows
// ---------------------------------------
// * Quest accepts go through ensureAccept(), never acceptQuest(). ensureAccept returns true for an
//   already-accepted or completed quest, so the loop terminates instead of spinning. Quest actions are
//   paced by QuestManager.ACTION_COOLDOWN_MS (1100ms = 1000ms server cooldown + 100ms lag margin);
//   calling accept directly in a loop would ignore that gate and risk server-side rejection.
// * One quest action per tick at most. The manager queues and paces internally; this script only ever
//   has one request in flight.
// * Logging is throttled. ApiLogger collapses repeats inside a 2s window, and a per-tick log would
//   drown the signal it is meant to provide.
// * Never sum getTempQuantity() and getQuantity() into one "total". That is the bug this script exists
//   to detect, not commit.

var questIds = [9421, 9422, 9423];
var medals = ["Shadow Hunt Medal", "Mega Shadow Hunt Medal"];

var lastSnapshot = {};     // name -> last logged total, to spot phantom growth
var lastTotalReport = 0;
var tickCount = 0;
var loggedOnce = {};

function onStart() {
    log("=== Shadow Battleon temp-item tracking diagnostic ===");
    log("Quests: 9421, 9422, 9423");
    log("Watching: " + medals.join(", "));
    join("shadowbattleon");
    log("Joining shadowbattleon...");
}

function onTick() {
    tickCount++;

    // Quest accepts: one request in flight, and only while any quest is still outstanding.
    var pending = acceptPendingQuests();
    if (pending) return;

    // Report cadence: every ~5s of ticks rather than every tick.
    if (tickCount % 50 == 0) report();
}

// Returns true while an accept request is still outstanding this tick.
function acceptPendingQuests() {
    for (id in questIds) {
        var qid = Std.parseInt(Std.string(id));
        if (qid == null) continue;
        // ensureAccept is the safe form: true for accepted/completed/loading quests, so it never
        // re-requests. It respects the internal 1100ms action cooldown.
        if (!ensureAccept(qid)) {
            if (!loggedOnce["a" + qid]) {
                loggedOnce["a" + qid] = true;
                log("Quest " + qid + ": accept requested");
            }
            return true;   // still busy; do not poll items this tick
        }
    }
    return false;
}

function report() {
    log("--- report (tick " + tickCount + ") ---");

    for (name in medals) {
        var item = Std.string(name);

        var temp = getTempQuantity(item);
        var inv = getInventoryQuantity(item);
        var quest = getQuestQuantity(item);
        var where = getItemLocation(item);
        var found = findItem(item);

        // `quest` is the de-duplicated reading. temp and inv are separate containers and must NOT be
        // summed - that is exactly the double-count we are testing for.
        var summed = temp + inv;

        log(item + ": temp=" + temp + " inv=" + inv + " quest(dedup)=" + quest +
            " wouldBeSum=" + summed + " location=" + (where == "" ? "none" : where) +
            (found == null ? "" : " qty=" + found.quantity));

        if (quest > temp && quest > inv && quest > 0) {
            log("  !! " + item + ": quest(" + quest + ") exceeds both containers(" + temp + "," + inv +
                ") - possible double count");
        }

        // Phantom-growth check: total must not move while we are not picking anything up.
        var prev = lastSnapshot[item];
        if (prev == null) {
            lastSnapshot[item] = quest;
        } else if (prev != quest) {
            log("  " + item + " changed " + prev + " -> " + quest + " (pickup or turn-in)");
            lastSnapshot[item] = quest;
        }
    }

    // Quest state, so a stuck accept is visible.
    for (id in questIds) {
        var qid = Std.parseInt(Std.string(id));
        if (qid == null) continue;
        log("Quest " + qid + ": accepted=" + isQuestAccepted(qid) + " complete=" + isQuestComplete(qid));
    }
}

function onStop() {
    log("=== diagnostic stopped after " + tickCount + " ticks ===");
}