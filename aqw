#!/usr/bin/env bash
# Single entry point for AQW Mobile Mod.
set -Eeuo pipefail
DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
CLIENT="$DIR/loader"; BUILD="$DIR/build"; STAGING="$BUILD/staging"
usage(){ cat <<'EOF'
Usage: ./aqw <doctor|build|run|android|clean|sync> [options]
  doctor                    Check repositories and required tools
  build [--no-sync]          Freshly build API, UI, Desktop.swf and Mobile.swf
  run [--cpu|--direct|--gpu] Build if needed, then launch via Wine/ADL
  android [--arch armv7|armv8] [--mode cpu|direct|gpu|all]
  clean [--all]              Remove generated artifacts; --all also removes caches
  sync                       Refresh upstream gamefiles
EOF
}
die(){ echo "ERROR: $*" >&2; exit 1; }
load_repos(){
  [[ ! -f "$DIR/local-repos.sh" ]] || . "$DIR/local-repos.sh"
  HAXE_API_DIR="${HAXE_API_DIR:-$DIR/../aqw-haxe-api}"; HAXE_UI_DIR="${HAXE_UI_DIR:-$DIR/../aqw-haxe-ui}"
  [[ "$HAXE_API_DIR" == /* ]] || HAXE_API_DIR="$DIR/$HAXE_API_DIR"
  [[ "$HAXE_UI_DIR" == /* ]] || HAXE_UI_DIR="$DIR/$HAXE_UI_DIR"
  [[ -d "$HAXE_API_DIR" && -f "$HAXE_API_DIR/build.hxml" ]] || die "Haxe API checkout/build.hxml missing: $HAXE_API_DIR"
  [[ -d "$HAXE_UI_DIR" && -f "$HAXE_UI_DIR/build.hxml" ]] || die "Haxe UI checkout/build.hxml missing: $HAXE_UI_DIR"
}
repo(){ printf '=> %s: %s' "$1" "$2"; if git -C "$2" rev-parse --is-inside-work-tree >/dev/null 2>&1; then printf ' [branch=%s commit=%s]' "$(git -C "$2" branch --show-current || echo detached)" "$(git -C "$2" rev-parse --short HEAD)"; fi; printf '\n'; }
resolve_java(){
 if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then return; fi
 local j; j="$(command -v java || true)"; [[ -n "$j" ]] || die "Java/JDK not found; set JAVA_HOME."
 j="$(readlink -f "$j" 2>/dev/null || echo "$j")"; [[ "$j" == */bin/java && -x "${j%/bin/java}/bin/javac" ]] || die "JDK required; set JAVA_HOME."
 JAVA_HOME="${j%/bin/java}"; export JAVA_HOME
}
resolve_air(){
 AIR_HOME="${AIR_HOME:-${AIRSDK_HOME:-${HOME}/.airsdk/AIRSDK_Linux}}"
  [[ -d "$AIR_HOME" ]] || AIR_HOME=""
 AMXMLC="$(command -v amxmlc 2>/dev/null || true)"; ADT="$(command -v adt 2>/dev/null || true)"
 [[ -n "$AMXMLC" ]] || { [[ -n "$AIR_HOME" && -x "$AIR_HOME/bin/amxmlc" ]] && AMXMLC="$AIR_HOME/bin/amxmlc"; }
 [[ -n "$ADT" ]] || { [[ -n "$AIR_HOME" && -x "$AIR_HOME/bin/adt" ]] && ADT="$AIR_HOME/bin/adt"; }
 [[ -n "${AMXMLC:-}" ]] || die "amxmlc not found; set AIR_HOME/AIRSDK_HOME."
 [[ -n "${ADT:-}" ]] || die "adt not found; set AIR_HOME or PATH."
 resolve_java; export AIR_HOME JAVA_HOME; export PATH="$(dirname "$AMXMLC"):$JAVA_HOME/bin:$PATH"
}
resolve_flex(){
 local t p
 for t in abcexport abcreplace; do
  p=""; [[ -z "${FLEX_HOME:-}" || ! -x "$FLEX_HOME/bin/$t" ]] || p="$FLEX_HOME/bin/$t"
  [[ -n "$p" || -z "${FLEX_SDK:-}" || ! -x "$FLEX_SDK/bin/$t" ]] || p="$FLEX_SDK/bin/$t"
  [[ -n "$p" ]] || p="$(command -v "$t" 2>/dev/null || true)"
  [[ -n "$p" ]] || die "$t missing; set FLEX_HOME/FLEX_SDK."
  export PATH="$(dirname "$p"):$PATH"
 done
}
haxe_build(){ (cd "$1"; if command -v haxe >/dev/null; then haxe build.hxml; elif command -v pnpm >/dev/null; then pnpm exec haxe build.hxml; else npx haxe build.hxml; fi); }
haxe_ui() (
 project="$1"; api="$2"; tmp="$(mktemp "$project/.build-local.XXXXXX.hxml")"; trap 'rm -f "$tmp"' EXIT
 awk -v api_src="$api/src" '$0=="-cp ../aqw-haxe-api/src"{printf "-cp %s\n",api_src;done=1;next}{print}END{if(!done)printf "-cp %s\n",api_src}' "$project/build.hxml" > "$tmp"
 cd "$project"; if command -v haxe >/dev/null; then haxe "$tmp"; elif command -v pnpm >/dev/null; then pnpm exec haxe "$tmp"; else npx haxe "$tmp"; fi
)
strip_descriptor(){ python3 -c 'import re,sys;sys.stdout.write(re.sub(r"[ \t]*<extensions>.*?</extensions>\s*","",sys.stdin.read(),flags=re.S))' < "$1" > "$2"; }
doctor(){
 load_repos; repo API "$HAXE_API_DIR"; repo UI "$HAXE_UI_DIR"
 for t in git haxe java python3 sha256sum; do command -v "$t" >/dev/null 2>&1 && echo "OK $t: $(command -v "$t")" || echo "MISSING $t"; done
 for f in loader/src/Pocket.as loader/src/ModBootstrap.as loader/Desktop.swf loader/Mobile.swf loader/worker-src/WorkerMain.as; do [[ -f "$DIR/$f" ]] && echo "OK $f" || echo "MISSING $f"; done
}
build(){
 local sync=1 arg label desk mob
 for arg in "$@"; do [[ "$arg" == --no-sync ]] && sync=0 || [[ "$arg" == --no-sync ]] || die "Unknown build option: $arg"; done
 load_repos; resolve_air; resolve_flex; repo API "$HAXE_API_DIR"; repo UI "$HAXE_UI_DIR"
 for f in src/Pocket.as src/ModBootstrap.as Desktop.swf Mobile.swf Desktop-app.xml Mobile-app.xml worker-src/WorkerMain.as; do [[ -f "$CLIENT/$f" ]] || die "Required loader file missing: loader/$f"; done
 grep -q 'ModBootstrap.init(this)' "$CLIENT/src/Pocket.as" || die "Pocket.as missing ModBootstrap.init(this)."
 mkdir -p "$BUILD"; rm -f "$BUILD/Desktop.swf" "$BUILD/Mobile.swf"; rm -rf "$STAGING"; mkdir -p "$STAGING/libs" "$STAGING/assets"
 if ((sync)) && [[ "${SKIP_SYNC:-0}" != 1 ]]; then "$DIR/sync-gamefiles.sh" "$BUILD/gamefiles-upstream"; else echo "=> Sync skipped; using cached gamefiles."; fi
 cp -r "$CLIENT/src" "$STAGING/src"; cp -r "$CLIENT/worker-src" "$STAGING/worker-src"; [[ ! -d "$CLIENT/assets" ]] || cp -r "$CLIENT/assets/." "$STAGING/assets/"
 cp -r "$CLIENT/icons" "$STAGING/icons"; cp "$CLIENT/Desktop-app.xml" "$CLIENT/Mobile-app.xml" "$STAGING/"
 cp "$CLIENT/Desktop.swf" "$CLIENT/Mobile.swf" "$STAGING/"; mkdir -p "$STAGING/gamefiles"; [[ ! -d "$CLIENT/libs" ]] || cp -r "$CLIENT/libs/." "$STAGING/libs/"
 if [[ -d "$BUILD/gamefiles-upstream" && -n "$(ls -A "$BUILD/gamefiles-upstream" 2>/dev/null)" ]]; then mkdir -p "$STAGING/gamefiles"; cp -r "$BUILD/gamefiles-upstream/." "$STAGING/gamefiles/"
 elif [[ -d "$CLIENT/gamefiles" ]]; then mkdir -p "$STAGING/gamefiles"; cp -r "$CLIENT/gamefiles/." "$STAGING/gamefiles/"; fi
 rm -f "$STAGING/gamefiles/book-of-lore.swf" "$STAGING/gamefiles/character-select.swf"; rm -rf "$STAGING/gamefiles/embed"
 echo "=> [1/4] Preparing as3swf dependency"; local AS3SWF_DIR="${AS3SWF_DIR:-$BUILD/deps/as3swf}"; if [[ ! -f "$AS3SWF_DIR/src/com/codeazur/as3swf/SWF.as" ]]; then mkdir -p "$(dirname "$AS3SWF_DIR")"; git clone --depth 1 https://github.com/claus/as3swf.git "$AS3SWF_DIR" || die "Could not fetch the as3swf dependency"; fi; [[ -f "$AS3SWF_DIR/src/com/codeazur/as3swf/SWF.as" ]] || die "as3swf source missing at $AS3SWF_DIR/src"; echo "=> [2/5] Compiling worker"; mkdir -p "$CLIENT/libs"; rm -f "$CLIENT/libs/WorkerMain.swf"; "$AMXMLC" +configname=air -strict=false -debug=true -source-path+="$CLIENT/worker-src" -source-path+="$AS3SWF_DIR/src" -output "$CLIENT/libs/WorkerMain.swf" "$CLIENT/worker-src/WorkerMain.as" || die "Worker compilation failed"
 [[ -s "$CLIENT/libs/WorkerMain.swf" ]] || die "Worker compilation did not produce loader/libs/WorkerMain.swf"
 cp "$CLIENT/libs/WorkerMain.swf" "$STAGING/libs/WorkerMain.swf"
 echo "Worker SHA-256: $(sha256sum "$CLIENT/libs/WorkerMain.swf" | awk '{print $1}')"
 echo "=> [2/4] Compiling API"; rm -f "$HAXE_API_DIR/bin/AqwApi.swc"; haxe_build "$HAXE_API_DIR"
 [[ -s "$HAXE_API_DIR/bin/AqwApi.swc" ]] || die "API did not produce bin/AqwApi.swc"
 cp "$HAXE_API_DIR/bin/AqwApi.swc" "$STAGING/libs/AqwApi.swc"; cmp -s "$HAXE_API_DIR/bin/AqwApi.swc" "$STAGING/libs/AqwApi.swc" || die "Staged API SWC mismatch"
 echo "API SHA-256: $(sha256sum "$STAGING/libs/AqwApi.swc" | awk '{print $1}')"
 echo "=> [3/4] Compiling UI"; rm -f "$HAXE_UI_DIR/bin/ModUI.swc"; haxe_ui "$HAXE_UI_DIR" "$HAXE_API_DIR"
 [[ -s "$HAXE_UI_DIR/bin/ModUI.swc" ]] || die "UI did not produce bin/ModUI.swc"
 cp "$HAXE_UI_DIR/bin/ModUI.swc" "$STAGING/libs/ModUI.swc"; cmp -s "$HAXE_UI_DIR/bin/ModUI.swc" "$STAGING/libs/ModUI.swc" || die "Staged UI SWC mismatch"
 echo "UI SHA-256: $(sha256sum "$STAGING/libs/ModUI.swc" | awk '{print $1}')"; [[ -s "$STAGING/libs/WorkerMain.swf" ]] || die "WorkerMain.swf missing"
 echo "=> [4/4] Compiling and injecting SWFs"
 for label in Desktop Mobile; do
  if [[ "$label" == Desktop ]]; then desk=true; mob=false; else desk=false; mob=true; fi
  "$AMXMLC" +configname=air -strict=false -debug=true -default-size 960 550 -default-frame-rate 120 -default-background-color 0x000000 -define+=POCKET::IS_DESKTOP,"$desk" -define+=POCKET::IS_MOBILE,"$mob" -library-path+="$STAGING/libs" -source-path+="$STAGING/src" -output "$STAGING/${label}_code.swf" "$STAGING/src/Pocket.as"
  (cd "$STAGING"; abcexport "${label}_code.swf"; abcreplace "$label.swf" 0 "${label}_code-0.abc"; rm -f "${label}_code-0.abc" "${label}"-*.abc)
  cp "$STAGING/$label.swf" "$BUILD/$label.swf"
 done
 rm -rf "$BUILD/assets" "$BUILD/icons" "$BUILD/gamefiles" "$BUILD/META-INF" "$BUILD/libs"
 cp -r "$STAGING/assets" "$BUILD/assets"; cp -r "$STAGING/icons" "$BUILD/icons"; cp -r "$STAGING/libs" "$BUILD/libs"
 [[ -s "$BUILD/libs/WorkerMain.swf" ]] || die "WorkerMain.swf missing from runnable build output"
 [[ ! -d "$STAGING/gamefiles" ]] || cp -r "$STAGING/gamefiles" "$BUILD/gamefiles"
 [[ ! -d "$CLIENT/META-INF" ]] || cp -r "$CLIENT/META-INF" "$BUILD/META-INF"
 strip_descriptor "$CLIENT/Desktop-app.xml" "$BUILD/Desktop-app.xml"
 for label in cpu direct gpu; do sed "s|<renderMode>.*</renderMode>|<renderMode>$label</renderMode>|" "$BUILD/Desktop-app.xml" > "$BUILD/Desktop-app-$label.xml"; done
 echo "=> Build complete"; ls -lh "$BUILD/Desktop.swf" "$BUILD/Mobile.swf"
}
run_client(){
 local mode="" descriptor=Desktop-app.xml adl=""
 while (($#)); do case "$1" in --cpu|--direct|--gpu) [[ -z "$mode" ]] || die "Choose one render mode"; mode="${1#--}"; shift;; *) die "Unknown run option: $1";; esac; done
 [[ -s "$BUILD/Desktop.swf" ]] || build
 if [[ -n "$mode" ]]; then descriptor=Desktop-app-launch.xml; sed "s|<renderMode>.*</renderMode>|<renderMode>$mode</renderMode>|" "$BUILD/Desktop-app.xml" > "$BUILD/$descriptor"; fi
 trap 'rm -f "$BUILD/Desktop-app-launch.xml"' EXIT
 mkdir -p "$BUILD/assets"; touch "$BUILD/assets/api.log"; ln -sf "$BUILD/assets/api.log" "$DIR/api.log" 2>/dev/null || true
 # Prefer Windows ADL through Wine by default; native Linux ADL is an explicit opt-in.
 if [[ "${AQW_ADL:-wine}" == "linux" ]]; then
   adl="${AIRSDK_LINUX:-${HOME}/.airsdk/AIRSDK_Linux/bin/adl_linux64}"
   [[ -x "$adl" ]] || die "Linux ADL not found or not executable: $adl"
   echo "=> Launching with Linux ADL: $adl"
   (cd "$BUILD"; "$adl" -profile extendedDesktop "$descriptor")
   return
 fi
 [[ "${AQW_ADL:-wine}" == "wine" ]] || die "Unknown AQW_ADL value '${AQW_ADL}'; use wine or linux."
 adl="${AIRSDK_WINDOWS:-${AIR_WINDOWS_HOME:-${HOME}/.airsdk/AIRSDK_Windows/bin}}"
 # Accept either the executable path, the SDK's bin directory, or the SDK root.
 if [[ -d "$adl" ]]; then
   if [[ -f "$adl/bin/adl64.exe" ]]; then adl="$adl/bin/adl64.exe"
   elif [[ -f "$adl/adl64.exe" ]]; then adl="$adl/adl64.exe"
   else adl="$adl/adl64.exe"
   fi
 fi
 [[ -f "$adl" ]] || die "Windows ADL not found: $adl (expected /home/me/.airsdk/AIRSDK_Windows/bin/adl64.exe; set AIRSDK_WINDOWS to the executable, SDK root, or bin directory)"
 command -v wine >/dev/null 2>&1 || die "Wine is unavailable; install Wine or set AQW_ADL=linux to use native Linux ADL."
 echo "=> Launching with Windows ADL via Wine: $adl"
 (cd "$BUILD"; wine "$adl" -profile extendedDesktop "$descriptor")
}
android(){
 local archs="${ANDROID_ARCHS:-armv7 armv8}" modes=all keystore="${KEYSTORE:-$DIR/aqwpocket_keystore_local.p12}" arg arch mode abi version date outdir xml
 while (($#)); do case "$1" in --arch) (($#>1)) || die "--arch needs a value"; archs="$2"; shift 2;; --mode) (($#>1)) || die "--mode needs a value"; modes="$2"; shift 2;; *) die "Unknown android option: $1";; esac; done
 build; resolve_air; [[ -f "$keystore" ]] || "$ADT" -certificate -cn AQWPocketLocal 2048-RSA "$keystore" password
 version="$(grep -oPm1 '(?<=<versionNumber>)[^<]+' "$CLIENT/Mobile-app.xml" 2>/dev/null || echo 3.6.0)"; date="${BUILD_DATE:-$(date +%d-%m-%y)}"; outdir="${OUTPUT_DIR:-$DIR/../android_builds}"; mkdir -p "$outdir"
 [[ "$modes" != all ]] || modes="cpu direct gpu"; read -r -a arch_list <<< "$archs"; read -r -a mode_list <<< "$modes"
 for arch in "${arch_list[@]}"; do case "$arch" in armv7) abi=armeabi-v7a;; armv8) abi=arm64-v8a;; *) die "Unknown arch $arch";; esac
  for mode in "${mode_list[@]}"; do [[ "$mode" == cpu || "$mode" == direct || "$mode" == gpu ]] || die "Unknown mode $mode"
   out="$outdir/AQWMod-$version-$date-$arch-$mode.apk"; xml="$BUILD/Mobile-app-$arch-$mode.xml"
   sed "s|<renderMode>.*</renderMode>|<renderMode>$mode</renderMode>|" "$STAGING/Mobile-app.xml" > "$xml"; rm -f "$out"
   "$ADT" -package -arch "$arch" -target apk-captive-runtime -storetype PKCS12 -keystore "$keystore" -storepass password "$out" "$xml" -C "$BUILD" Mobile.swf -C "$STAGING" libs assets icons/icon-36x36.png icons/icon-48x48.png icons/icon-72x72.png icons/icon-96x96.png icons/icon-144x144.png icons/icon-192x192.png gamefiles
   rm -f "$xml"; python3 - "$out" "$abi" <<'PYAPK'
import sys,zipfile
with zipfile.ZipFile(sys.argv[1]) as z: names=z.namelist()
if not any(n.startswith("lib/"+sys.argv[2]+"/") and n.endswith(".so") for n in names): raise SystemExit("Missing native library ABI: "+sys.argv[2])
print("Verified ABI "+sys.argv[2])
PYAPK
   echo "=> Created $out"
  done
 done
}
clean(){ local all=0; for arg in "$@"; do [[ "$arg" == --all ]] && all=1 || die "Unknown clean option: $arg"; done
 if ((all)); then rm -rf "$BUILD"; echo "Removed build/ and caches"; else rm -rf "$STAGING" "$BUILD/assets" "$BUILD/icons" "$BUILD/gamefiles" "$BUILD/META-INF"; rm -f "$BUILD"/Desktop-app-*.xml "$BUILD"/Mobile-app-*.xml "$BUILD/Desktop.swf" "$BUILD/Mobile.swf"; echo "Removed generated artifacts; download caches preserved"; fi
}
cmd="${1:-help}"; shift || true
case "$cmd" in help|-h|--help) usage;; doctor) doctor;; build) build "$@";; run) run_client "$@";; android) android "$@";; clean) clean "$@";; sync) "$DIR/sync-gamefiles.sh";; *) usage >&2; die "Unknown command: $cmd";; esac
