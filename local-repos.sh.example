# Copy this file to local-repos.sh and adjust paths if your checkouts are elsewhere.
# Relative paths are resolved from the aqw-mobile-mod checkout; absolute paths are also accepted.
# The build scripts source local-repos.sh automatically when it exists.
#
# Keep local-repos.sh untracked: machine-specific overrides must never be committed.
HAXE_API_DIR="../aqw-haxe-api"
HAXE_UI_DIR="../aqw-haxe-ui"
